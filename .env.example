APP_ENV=development
DATABASE_URL=postgresql+psycopg://news:news@localhost:5432/news
# If a local PostgreSQL already uses 5432, set another host port here and in
# DATABASE_URL above. Container-to-container connections continue to use 5432.
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
# Set a random value before using the inspection endpoints. This is an operator
# credential, not customer authentication. Clerk/Supabase integration is Week 4.
OPERATOR_API_KEY=
# Set a descriptive contact address for production fetching.
USER_AGENT=AINewsAggregator/0.1
SOURCE_LIMIT=100
INITIAL_LOOKBACK_DAYS=7
CLUSTER_WINDOW_HOURS=72
CLUSTER_SIMILARITY=0.85
ENRICH_ARTICLES=true
INGESTION_INTERVAL_SECONDS=1800
