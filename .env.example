APP_ENV=development
DATABASE_URL=postgresql+psycopg://news:news@localhost:5432/news
# If a local PostgreSQL already uses 5432, set another host port here and in
# DATABASE_URL above. Container-to-container connections continue to use 5432.
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
# Set a random value before using the inspection endpoints. This is an operator
# credential for pipeline inspection. Customers use Supabase Auth separately.
OPERATOR_API_KEY=
# Set a descriptive contact address for production fetching.
USER_AGENT=AINewsAggregator/0.1
SOURCE_LIMIT=100
INITIAL_LOOKBACK_DAYS=7
CLUSTER_WINDOW_HOURS=72
CLUSTER_SIMILARITY=0.85
ENRICH_ARTICLES=true
INGESTION_INTERVAL_SECONDS=1800

# Shared two-pass analysis. Set your key locally; never commit actual credentials.
DEEPSEEK_API_KEY=
SUMMARY_MODEL=deepseek-flash
ANALYSIS_MODEL=deepseek-v4-pro
# Explicit `ai-news analyze` works independently of this scheduling switch.
ANALYSIS_ENABLED=false
ANALYSIS_CLUSTER_LIMIT=10
# Conservative estimated spend ceiling per analysis run, in USD.
ANALYSIS_BUDGET_USD=0.25
ANALYSIS_TIMEOUT_SECONDS=60
SUMMARY_MAX_TOKENS=768
ANALYSIS_MAX_TOKENS=2048

# Customer dashboard. Use the SAME Supabase project for frontend and backend.
# Only the project URL and publishable key are needed; never a service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
DASHBOARD_PORT=3000
DASHBOARD_DEMO_MODE=false
